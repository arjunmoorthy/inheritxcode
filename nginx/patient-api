server {  
    server_name oncolife-patient-api.inheritxdev.in;

    client_max_body_size 50M;

    location / {
        # Proxy to Docker container
        proxy_pass http://oncolife-patient-api:8000; 
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frame-Options SAMEORIGIN;
        proxy_set_header X-XSS-Protection "1; mode=block";
        proxy_set_header X-Content-Type-Options nosniff;
        proxy_hide_header X-Powered-By;
    }

    add_header X-Frame-Options DENY;

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/oncolife-patient-api.inheritxdev.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oncolife-patient-api.inheritxdev.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = oncolife-patient-api.inheritxdev.in) {
        return 301 https://$host$request_uri;
    }

    server_name oncolife-patient-api.inheritxdev.in;
    listen 80;
    return 404;
}
